#
# Recovery fstab for Motorola edge 40 neo (manaus)
# GKI 2.0 / Virtual A/B device

# ==================================================
# Boot Partitions
# ==================================================
/boot                   emmc        /dev/block/by-name/boot_a                   flags=backup=1;display=boot;slotselect
/vendor_boot            emmc        /dev/block/by-name/vendor_boot_a            flags=backup=1;display=vendor_boot;slotselect
/init_boot              emmc        /dev/block/by-name/init_boot_a              flags=backup=1;display=init_boot;slotselect
/dtbo                   emmc        /dev/block/by-name/dtbo_a                   flags=backup=1;display=dtbo;slotselect
/vbmeta                 emmc        /dev/block/by-name/vbmeta_a                 flags=backup=1;display=vbmeta;slotselect
/vbmeta_system          emmc        /dev/block/by-name/vbmeta_system_a          flags=backup=1;display=vbmeta_system;slotselect

# ==================================================
# Super Partition (Virtual A/B)
# ==================================================
/super                  emmc        /dev/block/by-name/super                    flags=backup=1;display=Super

# ==================================================
# Dynamic Partitions (Logical)
# ==================================================
/system                 ext4        system                                      flags=backup=1;display=system;logical;slotselect
/system                 erofs       system                                      flags=backup=1;display=system;logical;slotselect
/system_ext             ext4        system_ext                                  flags=backup=1;display=system_ext;logical;slotselect
/system_ext             erofs       system_ext                                  flags=backup=1;display=system_ext;logical;slotselect
/vendor                 ext4        vendor                                      flags=backup=1;display=vendor;logical;slotselect
/vendor                 erofs       vendor                                      flags=backup=1;display=vendor;logical;slotselect
/product                ext4        product                                     flags=backup=1;display=product;logical;slotselect
/product                erofs       product                                     flags=backup=1;display=product;logical;slotselect
/vendor_dlkm            ext4        vendor_dlkm                                 flags=backup=1;display=vendor_dlkm;logical;slotselect
/vendor_dlkm            erofs       vendor_dlkm                                 flags=backup=1;display=vendor_dlkm;logical;slotselect

# ==================================================
# User Data
# ==================================================
/data                   f2fs        /dev/block/by-name/userdata                 flags=encryptable=footer;length=-16384;display=data

# ==================================================
# Vendor Specific Partitions
# ==================================================
/metadata               ext4        /dev/block/by-name/metadata                 flags=display=metadata
/mnt/vendor/persist     ext4        /dev/block/by-name/persist                  flags=display=persist
/mnt/vendor/nvdata      ext4        /dev/block/by-name/nvdata                   flags=display=nvdata
/mnt/vendor/nvcfg       ext4        /dev/block/by-name/nvcfg                    flags=display=nvcfg
/mnt/vendor/protect_f   ext4        /dev/block/by-name/protect1                 flags=display=protect_f
/mnt/vendor/protect_s   ext4        /dev/block/by-name/protect2                 flags=display=protect_s
/mnt/product/persist    ext4        /dev/block/by-name/prodpersist              flags=display=prodpersist

# ==================================================
# MediaTek Specific Partitions
# ==================================================
/nvram                  emmc        /dev/block/by-name/nvram                    flags=display=nvram;backup=1
/proinfo                emmc        /dev/block/by-name/proinfo                  flags=display=proinfo;backup=1
/frp                    emmc        /dev/block/by-name/frp                      flags=display=frp;backup=1
/misc                   emmc        /dev/block/by-name/misc                     flags=display=misc;backup=1
/expdb                  emmc        /dev/block/by-name/expdb                    flags=display=expdb
/seccfg                 emmc        /dev/block/by-name/seccfg                   flags=display=seccfg
/tee1                   emmc        /dev/block/by-name/tee1                     flags=display=tee1
/tee2                   emmc        /dev/block/by-name/tee2                     flags=display=tee2
/scp1                   emmc        /dev/block/by-name/scp1                     flags=display=scp1
/scp2                   emmc        /dev/block/by-name/scp2                     flags=display=scp2
/sspm_1                 emmc        /dev/block/by-name/sspm_1                   flags=display=sspm_1
/sspm_2                 emmc        /dev/block/by-name/sspm_2                   flags=display=sspm_2
/dpm_1                  emmc        /dev/block/by-name/dpm_1                    flags=display=dpm_1
/dpm_2                  emmc        /dev/block/by-name/dpm_2                    flags=display=dpm_2
/mcupm_1                emmc        /dev/block/by-name/mcupm_1                  flags=display=mcupm_1
/mcupm_2                emmc        /dev/block/by-name/mcupm_2                  flags=display=mcupm_2
/gz1                    emmc        /dev/block/by-name/gz1                      flags=display=gz1
/gz2                    emmc        /dev/block/by-name/gz2                      flags=display=gz2
/spmfw                  emmc        /dev/block/by-name/spmfw                    flags=display=spmfw
/audio_dsp              emmc        /dev/block/by-name/audio_dsp                flags=display=audio_dsp
/md1img                 emmc        /dev/block/by-name/md1img_a                 flags=display=md1img;slotselect
/md1dsp                 emmc        /dev/block/by-name/md1dsp_a                 flags=display=md1dsp;slotselect
/md1arm7                emmc        /dev/block/by-name/md1arm7_a                flags=display=md1arm7;slotselect
/md3img                 emmc        /dev/block/by-name/md3img                   flags=display=md3img
/pi_img                 emmc        /dev/block/by-name/pi_img                   flags=display=pi_img
/boot_para              emmc        /dev/block/by-name/boot_para                flags=display=boot_para
/odmdtbo                emmc        /dev/block/by-name/odmdtbo_a                flags=display=odmdtbo;slotselect
/logo                   emmc        /dev/block/by-name/logo                     flags=display=logo
/efuse                  emmc        /dev/block/by-name/efuse                    flags=display=efuse
/otp                    emmc        /dev/block/by-name/otp                      flags=display=otp
/bootloader             emmc        /dev/block/by-name/lk                       flags=display=bootloader;backup=1
/bootloader2            emmc        /dev/block/by-name/lk2                      flags=display=bootloader2;backup=1
/para                   emmc        /dev/block/by-name/para                     flags=display=para

# ==================================================
# Preloader
# ==================================================
/preloader              emmc        /dev/block/mmcblk0boot0                     flags=display=preloader;backup=1
/preloader2             emmc        /dev/block/mmcblk0boot1                     flags=display=preloader2;backup=1

# ==================================================
# External Storage
# ==================================================
/auto                   vfat        /devices/platform/usb*                      flags=display=usb;storage;removable
/auto                   vfat        /devices/platform/soc/*.usb*                flags=display=usb;storage;removable