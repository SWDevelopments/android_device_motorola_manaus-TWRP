# Logical Partitions (Dynamic/Super)
/system                   erofs      system                             flags=display=System;logical;slotselect;backup=1
/system_ext               erofs      system_ext                         flags=display=System Ext;logical;slotselect;backup=1
/vendor                   erofs      vendor                             flags=display=Vendor;logical;slotselect;backup=1
/product                  erofs      product                            flags=display=Product;logical;slotselect;backup=1
/vendor_dlkm              erofs      vendor_dlkm                        flags=display=Vendor DLKM;logical;slotselect;backup=1

# Userdata & Metadata
/metadata                 ext4       /dev/block/by-name/metadata        flags=display=Metadata;backup=1
/data                     f2fs       /dev/block/by-name/userdata        flags=display=Data;backup=1;wipeingui;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption

# Boot Partitions
/boot                     emmc       /dev/block/by-name/boot            flags=display=Boot;backup=1;flashimg=1;slotselect
/vendor_boot              emmc       /dev/block/by-name/vendor_boot     flags=display=Vendor Boot;backup=1;flashimg=1;slotselect
/dtbo                     emmc       /dev/block/by-name/dtbo            flags=display=DTBO;backup=1;flashimg=1;slotselect

# VBMeta
/vbmeta                   emmc       /dev/block/by-name/vbmeta          flags=display=VBMeta;backup=1;flashimg=1;slotselect
/vbmeta_system            emmc       /dev/block/by-name/vbmeta_system   flags=display=VBMeta System;backup=1;flashimg=1;slotselect

# MediaTek Partitions
/nvram                    emmc       /dev/block/by-name/nvram           flags=display=NVRAM;backup=1;flashimg=1
/mnt/vendor/persist       ext4       /dev/block/by-name/persist         flags=display=Persist;backup=1
/logo                     emmc       /dev/block/by-name/logo            flags=display=Logo;backup=1;flashimg=1

# Removable Storage
/external_sd              vfat       /dev/block/mmcblk1p1               flags=display=SD Card;storage;wipeingui;removable
/usb_otg                  vfat       /devices/platform/usb_xhci*        flags=display=USB OTG;storage;wipeingui;removable