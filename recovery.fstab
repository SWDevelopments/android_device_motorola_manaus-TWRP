#
# Recovery fstab for Motorola Edge 40 Neo (manaus)
# Verified from device - Android 15
#

# Boot partitions
/boot                emmc    /dev/block/by-name/boot_a                 flags=slotselect;display=Boot;backup=1
/vendor_boot         emmc    /dev/block/by-name/vendor_boot_a          flags=slotselect;display=Vendor_Boot;backup=1
/init_boot           emmc    /dev/block/by-name/init_boot_a            flags=slotselect;display=Init_Boot;backup=1
/dtbo                emmc    /dev/block/by-name/dtbo_a                 flags=slotselect;display=DTBO;backup=1
/vbmeta              emmc    /dev/block/by-name/vbmeta_a               flags=slotselect;display=VBMeta;backup=1
/vbmeta_system       emmc    /dev/block/by-name/vbmeta_system_a        flags=slotselect;display=VBMeta_System;backup=1

# Dynamic partitions (EROFS)
/system              erofs   system                                    flags=display=System;logical;slotselect;backup=1
/system_ext          erofs   system_ext                                flags=display=System_Ext;logical;slotselect;backup=1
/vendor              erofs   vendor                                    flags=display=Vendor;logical;slotselect;backup=1
/product             erofs   product                                   flags=display=Product;logical;slotselect;backup=1
/vendor_dlkm         erofs   vendor_dlkm                               flags=display=Vendor_DLKM;logical;slotselect;backup=1

# Data and metadata
/data                f2fs    /dev/block/by-name/userdata               flags=display=Data;encryptable;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0
/metadata            ext4    /dev/block/by-name/metadata               flags=display=Metadata

# Vendor partitions
/mnt/vendor/persist  ext4    /dev/block/by-name/persist                flags=display=Persist;backup=1
/mnt/vendor/nvdata   ext4    /dev/block/by-name/nvdata                 flags=display=NVData
/mnt/vendor/nvcfg    ext4    /dev/block/by-name/nvcfg                  flags=display=NVCfg
/mnt/vendor/protect_f ext4   /dev/block/by-name/protect1               flags=display=Protect_F
/mnt/vendor/protect_s ext4   /dev/block/by-name/protect2               flags=display=Protect_S
/mnt/vendor/tzapp    ext4    /dev/block/by-name/tzapp_a                flags=display=TZApp

# EMMC partitions
/misc                emmc    /dev/block/by-name/misc                   flags=display=Misc
/frp                 emmc    /dev/block/by-name/frp                    flags=display=FRP
/nvram               emmc    /dev/block/by-name/nvram                  flags=display=NVRAM;backup=1
/proinfo             emmc    /dev/block/by-name/proinfo                flags=display=ProInfo;backup=1

# MediaTek partitions
/sspm_1              emmc    /dev/block/by-name/sspm_a                 flags=display=SSPM_1
/sspm_2              emmc    /dev/block/by-name/sspm_b                 flags=display=SSPM_2
/dpm_1               emmc    /dev/block/by-name/dpm_a                  flags=display=DPM_1
/dpm_2               emmc    /dev/block/by-name/dpm_b                  flags=display=DPM_2
/mcupm_1             emmc    /dev/block/by-name/mcupm_a                flags=display=MCUPM_1
/mcupm_2             emmc    /dev/block/by-name/mcupm_b                flags=display=MCUPM_2
/audio_dsp           emmc    /dev/block/by-name/audio_dsp_a            flags=display=Audio_DSP
/spmfw               emmc    /dev/block/by-name/spmfw_a                flags=display=SPMFW
/md1img              emmc    /dev/block/by-name/md1img_a               flags=display=MD1IMG
/gz1                 emmc    /dev/block/by-name/gz_a                   flags=display=GZ_1
/gz2                 emmc    /dev/block/by-name/gz_b                   flags=display=GZ_2
/scp1                emmc    /dev/block/by-name/scp_a                  flags=display=SCP_1
/scp2                emmc    /dev/block/by-name/scp_b                  flags=display=SCP_2
/preloader           emmc    /dev/block/mmcblk0boot0                   flags=display=Preloader;backup=1

# External storage
/auto                vfat    /devices/platform/usb_xhci*               flags=display=USB;removable;storage
